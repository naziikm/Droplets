{
  "manifest_version": 3,
  "name": "Idea Drip",
  "version": "1.0.0",
  "description": "A tiny glowing droplet that falls once every hour, delivering random ideas, questions, and thoughts.",
  "permissions": [
    "alarms",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/droplet.svg",
        "assets/sound.mp3",
        "styles/droplet.css",
        "data/ideas.json"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles/droplet.css"]
    }
  ]
}
